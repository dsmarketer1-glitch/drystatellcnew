# ── DataPins environment variables ──
# Copy to .env (gitignored) for local dev, and set the same in Vercel's dashboard.
# Leave these UNSET to run the local dev mock (no Firebase needed to preview).

# ── Firebase client (safe to expose — used by the browser for tech login) ──
# Vite requires the VITE_ prefix to expose a var to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project

# ── Server only (set in Vercel → Project → Settings → Environment Variables) ──
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Web API key, used server-side to verify ID tokens via Identity Toolkit REST.
FIREBASE_API_KEY=

# ── Cloudinary (free image storage — replaces Firebase Storage) ──
# From the Cloudinary dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional: AI description polish (omit to use the tech's raw caption) ──
ANTHROPIC_API_KEY=
